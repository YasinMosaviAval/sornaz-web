Options -Indexes
DirectoryIndex index.php front-controller.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteRule ^$ front-controller.php [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    RewriteRule ^(.*)$ front-controller.php [L,QSA]
</IfModule>
