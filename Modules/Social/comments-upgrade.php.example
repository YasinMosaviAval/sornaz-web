<?php
if (PHP_SAPI !== 'cli') { http_response_code(404); exit; }
try {
    require dirname(__DIR__,2).'/vendor/autoload.php';
    $app = require dirname(__DIR__,2).'/bootstrap/app.php';
    $db = db();
    $connection = (string)$db->getAttribute(PDO::ATTR_CONNECTION_STATUS);
    if (!preg_match('/localhost|127\.0\.0\.1|UNIX socket/i',$connection) && !in_array('--allow-remote',$argv,true)) {
        throw new RuntimeException('Remote database requires an authorized deployment.');
    }
    $db->exec(file_get_contents(__DIR__.'/comments-schema.sql'));
    echo "Social comments schema is ready. Existing data was preserved.\n";
} catch (Throwable $e) { fwrite(STDERR,"Comments migration did not complete. Check the database connection and schema permissions.\n"); exit(1); }
