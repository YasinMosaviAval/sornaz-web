{
    "name": "sornaz/framework",
    "description": "A simple PHP framework",
    "require": {
        "php": ">=8.0"
    },
    "scripts": {
        "style:check": "@php scripts/code-style.php check",
        "style:fix": "@php scripts/code-style.php fix",
        "quality:report": "@php scripts/php-maintainability.php report",
        "quality:check": "@php scripts/php-maintainability.php check",
        "test:release": "node scripts/run-release-tests.cjs --browser"
    },
    "autoload": {
        "classmap": ["core/", "Modules/"],
        "exclude-from-classmap": ["/Modules/System/Lib/HTMLPurifier/"],
        "psr-4": {
            "Core\\": "core/",
            "Modules\\": "Modules/",
            "PHPMailer\\PHPMailer\\": "Modules/System/Lib/PHPMailer/"
        },
        "files": [
            "core/support/helpers.php"
        ]
    }
}
