APP_ENV=production
APP_NAME="Sornaz Academy"
APP_KEY=

# Registration OTP: keep false when real delivery is required.
OTP_FAKE_IN_LOCAL=false

# SMTP / PHPMailer
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USER=
MAIL_PASS=
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME="Sornaz Academy"
MAIL_VERIFY_PEER=true

# SMS: kavenegar or melipayamak
SMS_PROVIDER=kavenegar
SMS_API_KEY=
SMS_SENDER=
SMS_KAVENEGAR_TEMPLATE=
SMS_KAVENEGAR_FORGOT_TEMPLATE=sornazforget
SMS_USERNAME=
SMS_PASSWORD=
SMS_FROM=
